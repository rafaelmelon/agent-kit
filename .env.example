# Supabase Personal Access Token
# Obtener en: supabase.com → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=sbp_...

# GitHub Personal Access Token (para operaciones con Issues/PRs via MCP o gh CLI)
# Obtener en: github.com → Settings → Developer settings → Personal access tokens
# Scopes necesarios: repo, read:org
GITHUB_TOKEN=ghp_...
